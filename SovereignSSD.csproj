<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SovereignSSD</AssemblyName>
    <RootNamespace>SovereignSSD</RootNamespace>
    <StartupObject>SovereignSSD.Program</StartupObject>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>src/App.manifest</ApplicationManifest>

    <!-- Single-file self-contained build without compressed extraction overhead -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Embed native compression DLL, INI configs, pre-compiled/source shaders, and ONNX models as manifest resources -->
  <ItemGroup>
    <EmbeddedResource Include="sovereign_compressor.dll" Condition="Exists('sovereign_compressor.dll')" LogicalName="SovereignSSD.Native.sovereign_compressor.dll" />
    <EmbeddedResource Include="vssdhx_dlss5_config.ini" Condition="Exists('vssdhx_dlss5_config.ini')" LogicalName="SovereignSSD.Config.vssdhx_dlss5_config.ini" />
    <EmbeddedResource Include="Shinobi_HPL3_DIP_Enhancer.fx" Condition="Exists('Shinobi_HPL3_DIP_Enhancer.fx')" LogicalName="SovereignSSD.Shaders.Shinobi_HPL3_DIP_Enhancer.fx" />
    <EmbeddedResource Include="*.ini" Exclude="vssdhx_dlss5_config.ini" LogicalName="SovereignSSD.Config.%(Filename)%(Extension)" />
    <EmbeddedResource Include="*.onnx" LogicalName="SovereignSSD.Models.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Keep cfapi.dll optional/external to avoid system Cloud Filter DLL collisions -->
  <ItemGroup>
    <None Include="cfapi.dll" Condition="Exists('cfapi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ini-parser-netstandard" Version="2.5.2" />
  </ItemGroup>

</Project>
