<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- CRITICAL: Enables native pointer memory operations for Rust C-FFI -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- SNAKE SAGE ENGINE METADATA -->
    <AssemblyName>SnakeSageEngine</AssemblyName>
    <RootNamespace>SnakeSageEngine</RootNamespace>
    <Product>Snake Sage Virtual LPU Engine</Product>
    <Company>Celsius Technology &amp; Media Group</Company>
    <Version>1.0.0</Version>

    <!-- EMBED UAC ELEVATION MANIFEST -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- HIGH-PERFORMANCE RUNTIME OPTIMIZATIONS -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- AUTOMATICALLY COPY NATIVE RUST COMPRESSOR DLL TO OUTPUT BINARY DIRECTORY -->
  <ItemGroup>
    <None Update="sovereign_compressor.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
